# Copy to .env (or point DOCDESK_ENV_FILE at a file outside the repo) and fill in.
# Never commit the real file.

# Switch agent bridge (not the Gateway UI)
SWITCH_API=http://localhost:8000
# A registration key from the Gateway "API Keys" page. Used once, to register docdesk.
SWITCH_REGISTRATION_KEY=replace-me
# Mattermost username of the teammate who should be in the demo rooms
DOCDESK_TEAMMATE=user

# LLM provider: auto | gemini | groq | opencode | fake
# auto picks Gemini if GEMINI_API_KEY is set, then Groq, then the OpenCode CLI, then the fake LLM.
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENCODE_MODEL=opencode/deepseek-v4.1-flash-free

# The repo DocDesk answers from
DOCDESK_REPO_URL=https://github.com/suhailult777/acme-shop-demo
DOCDESK_REPO_DIR=demo/acme-shop

# doc-fixer: a second Switch agent that fixes doc gaps and opens PRs (needs `gh auth login`)
DOCDESK_FIXER_NAME=doc-fixer
# Commit author for doc-fix commits in the demo repo
DOCDESK_GIT_NAME=
DOCDESK_GIT_EMAIL=
# How to call docker for the sandbox ("sudo docker" if your user is not in the docker group)
DOCDESK_DOCKER=docker
FIXER_OPENCODE_TIMEOUT=150
