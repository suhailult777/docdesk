# Copy to .env (or point DOCDESK_ENV_FILE at a file outside the repo) and fill in.
# Never commit the real file.

# Switch agent bridge (not the Gateway UI)
SWITCH_API=http://localhost:8000
# A registration key from the Gateway "API Keys" page. Used once, to register docdesk.
SWITCH_REGISTRATION_KEY=replace-me
# Mattermost username of the teammate who should be in the demo rooms
DOCDESK_TEAMMATE=user

# LLM provider: auto | openrouter | gemini | groq | opencode | fake
# auto tries OpenRouter if OPENROUTER_API_KEY is set, then Gemini, then Groq, then the OpenCode CLI,
# then the offline fake LLM.
LLM_PROVIDER=auto
# OpenRouter (free models). Model order: OPENROUTER_MODEL, else @preset/<OPENROUTER_PRESET>,
# else google/gemma-4-31b-it:free. OpenRouter falls back through up to 3 models.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_PRESET=
# Comma separated, defaults to gemma-4-31b-it:free, nemotron-3-ultra-550b-a55b:free, openrouter/free
OPENROUTER_FALLBACKS=
OPENROUTER_TIMEOUT=45
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENCODE_MODEL=opencode/deepseek-v4.1-flash-free

# The repo DocDesk answers from
DOCDESK_REPO_URL=https://github.com/suhailult777/acme-shop-demo
DOCDESK_REPO_DIR=demo/acme-shop

# doc-fixer: a second Switch agent that fixes doc gaps and opens PRs (needs `gh auth login`)
DOCDESK_FIXER_NAME=doc-fixer
# Commit author for doc-fix commits in the demo repo
DOCDESK_GIT_NAME=
DOCDESK_GIT_EMAIL=
# Who may approve or decline a doc-fix PR in #acme-docs-maint: chat usernames, comma separated.
# Empty means nobody can, so nothing merges. Falls back to DOCDESK_DOCS_OWNER.
DOCDESK_APPROVERS=
# Person the fixer asks for review when no agent holds the docs-owner role
DOCDESK_DOCS_OWNER=
# Commit the demo reset restores the stale docs from
DOCDESK_DEMO_BASELINE=3df5b73
# How to call docker for the sandbox ("sudo docker" if your user is not in the docker group)
DOCDESK_DOCKER=docker
FIXER_OPENCODE_TIMEOUT=150
